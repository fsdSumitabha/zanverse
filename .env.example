# The API the app talks to. No env loader is installed yet, so this file is a record only: the value the app uses is
# API_BASE_URL in src/api/endpoints.ts. The Android emulator reaches the dev machine's localhost at 10.0.2.2.
API_BASE_URL=http://10.0.2.2:3000
# Release builds use PRODUCTION_API_BASE_URL in src/api/endpoints.ts, an HTTPS host.

<resources>

    <!-- Android 12+ system splash: the ZAN mark at 128 dp on SplashView's background. SplashView then draws the same
         mark at the same size and place, so the hand-over does not jump. -->
    <style name="AppTheme" parent="Base.AppTheme">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>

</resources>
